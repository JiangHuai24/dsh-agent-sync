{
  "name": "@local/agent-sync",
  "version": "1.9.3",
  "description": "Mirror WorkBuddy, ZCode, Codex and other coding agents' sessions into DeepSeek Harness as live tasks, one workspace per application.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-agent-sync contributors",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "workbuddy",
    "zcode",
    "codex",
    "session-sync"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JiangHuai24/dsh-agent-sync.git"
  },
  "homepage": "https://github.com/JiangHuai24/dsh-agent-sync#readme",
  "bugs": {
    "url": "https://github.com/JiangHuai24/dsh-agent-sync/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "test/bundle.gate.mjs",
    "test/safety.gate.mjs"
  ],
  "scripts": {
    "test": "node --test test/core.test.mjs test/engine.test.mjs test/client.test.mjs && node test/bundle.gate.mjs && node test/safety.gate.mjs",
    "test:format": "node --test test/format.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
